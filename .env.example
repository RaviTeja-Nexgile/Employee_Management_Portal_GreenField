# Copy to .env to change the defaults. Both are optional.

# Port of the Vite dev server (the app's origin).
PORT=5173

# Port of the FastAPI server; Vite proxies /api to it.
API_PORT=8000

# SQLite file used by the API. Defaults to backend/data/employees.db.
# EMS_DB_PATH=backend/data/employees.db
